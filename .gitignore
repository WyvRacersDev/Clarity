node_modules/
.DS_Store

# Environment & sensitive files
credentials.json
tokens.json
.env
*.env
key.env

# Scratch / stray files (not source)
# Finder/editor duplicate-copy artifacts ("foo 2.ts", "foo 2/", "foo 2")
**/* 2.*
**/* 2

# Runtime data — Postgres is the source of truth; these dirs are
# recreated by the server at startup (mkdirSync) and hold local
# uploads / legacy JSON, not source.
app/socket-server/projects/local/
app/socket-server/projects/hosted/
app/socket-server/users/
app/socket-server/src/users/
