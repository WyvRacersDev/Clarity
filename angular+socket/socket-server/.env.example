# =============================================================================
# Clarity Socket.IO backend — environment configuration
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# =============================================================================

# ─── Runtime ─────────────────────────────────────────────────────────────────
# 'production' enables fail-fast checks: missing JWT_SECRET/DATABASE_URL throw,
# and wildcard ('*') CORS origins are refused. Leave unset (or 'development')
# for local dev, where insecure defaults are allowed with a loud warning.
NODE_ENV=development

# ─── Server binding ──────────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0            # '0.0.0.0' = all interfaces, 'localhost' = local only
SERVER_PORT=3000               # HTTP + Socket.IO port

# Frontend URL — used for OAuth redirects and as an allowed CORS origin.
FRONTEND_URL=http://localhost:4200

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins for both Express and Socket.IO.
# Development: '*' (allow all) is fine — the code also allows localhost/LAN.
# Production: '*' is REFUSED at startup. Set explicit origins here and/or via
# FRONTEND_URL (both are merged into the allow-list).
# Example (prod): https://app.example.com,https://admin.example.com
SOCKET_CORS_ORIGIN=*

# ─── Database ────────────────────────────────────────────────────────────────
# Postgres connection string (see docker-compose.yml). REQUIRED in production —
# startup throws if missing. In dev it falls back to the local compose default.
DATABASE_URL=postgres://clarity:clarity@localhost:5433/clarity

# ─── Auth / JWT ──────────────────────────────────────────────────────────────
# Secret used to sign/verify the backend's own JWTs. REQUIRED in production —
# startup throws if missing. In dev an insecure default is used with a warning.
# Generate a strong value: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-generate-a-strong-random-secret
JWT_EXPIRES_IN=7d              # token lifetime (e.g. 7d, 24h, 3600s)

# Socket.IO handshake auth strictness.
#   false (default): tokenless/invalid handshakes are allowed and fall back to
#                    legacy payload identity (permissive rollout).
#   true  (prod target): a missing/invalid JWT REJECTS the connection.
# AUTH_STRICT=true is the production target — enable it only once the frontend
# always sends the JWT via socket.handshake.auth.token. Flipping it requires
# live end-to-end testing, or every connection will be rejected.
AUTH_STRICT=false

# ─── Auth route rate limiting ────────────────────────────────────────────────
# Per-IP rate limit applied to POST /auth/login and POST /auth/register.
AUTH_RATE_LIMIT_WINDOW_MS=900000   # window in ms (default 15 min)
AUTH_RATE_LIMIT_MAX=10             # max requests per window per IP

# ─── Uploads ─────────────────────────────────────────────────────────────────
# Max accepted size (bytes) for an incoming uploadFile base64 payload.
# Enforced per-message in the file gateway and mirrored at the Socket.IO
# transport layer (maxHttpBufferSize). Default 10MB.
MAX_UPLOAD_BYTES=10485760

# ─── AI assistant (Gemini) ───────────────────────────────────────────────────
# API key for the Chat_Agent. Optional — set a real key to enable AI features.
GEMINI_API_KEY=placeholder-set-a-real-key-to-enable-ai

# ─── Email (Gmail app password) ──────────────────────────────────────────────
# Used by notification.service and invitation.service to send email via Gmail.
# GOOGLE_APP_PASSWORD is a Gmail "app password", NOT your real account password.
GOOGLE_APP_USER=your-gmail-address@gmail.com
GOOGLE_APP_PASSWORD=your-gmail-app-password

# ─── Google OAuth 2.0 client (login + Calendar/Gmail/Contacts) ───────────────
# These feed `npm run db:seed-google`, which upserts the google_credentials
# (id=1) DB row that the live OAuth path reads (they are NOT read directly at
# runtime). Create a "Web application" OAuth 2.0 client in Google Cloud, enable
# the Calendar/Gmail/People APIs, and register the redirect URIs
# http://localhost:3000/oauth2callback and http://localhost:3000/auth/google/callback.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback
